<Window x:Class="AudioRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Router" Height="750" Width="1100"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Audio Router" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Capture audio from any device and route it to another output"
                              FontSize="12" Foreground="#BDC3C7" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border x:Name="AdminBadge" Background="#E74C3C" CornerRadius="3" Padding="8,4" Margin="0,0,0,5">
                        <TextBlock Text="⚡ ADMIN MODE" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <Button x:Name="RestartAsAdminButton" Content="🔓 Run as Admin"
                           Click="RestartAsAdmin_Click" FontSize="10" Padding="8,4"
                           Background="#3498DB" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Create Routes -->
            <Border Grid.Column="0" Background="White" BorderBrush="#BDC3C7"
                   BorderThickness="1" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section Title -->
                    <TextBlock Grid.Row="0" Text="Create New Route" FontSize="16"
                              FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <!-- Audio Sessions -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,5">
                            <Run Text="Select Application to Route:"/>
                        </TextBlock>
                        <TextBlock Text="✨ Audio from this app will be duplicated to your chosen output"
                                  FontSize="10" Foreground="#27AE60" Margin="0,0,0,5" TextWrapping="Wrap"/>
                        <ListBox x:Name="AudioSessionsListBox" Height="150"
                                SelectionChanged="AudioSessionsListBox_SelectionChanged"/>
                        <Button Content="🔄 Refresh Applications" Click="RefreshSessions_Click"
                               HorizontalAlignment="Stretch" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Output Devices -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,5">
                            <Run Text="Route To (Output):"/>
                        </TextBlock>
                        <ComboBox x:Name="OutputDevicesComboBox"
                                 SelectionChanged="OutputDevicesComboBox_SelectionChanged"/>
                        <Button Content="🔄 Refresh Devices" Click="RefreshDevices_Click"
                               HorizontalAlignment="Stretch" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Latency Mode -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,10">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,5">
                            <Run Text="⚡ Latency Mode:"/>
                        </TextBlock>
                        <ComboBox x:Name="LatencyModeComboBox"
                                 SelectionChanged="LatencyModeComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource LatencyModeConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="LatencyInfoText" Text="Ultra Low: Best for movies/gaming"
                                  FontSize="10" Foreground="#7F8C8D" Margin="5,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Spacer -->
                    <Border Grid.Row="4"/>

                    <!-- Create Route Button -->
                    <Button Grid.Row="5" Content="▶️ Start Audio Route"
                           x:Name="StartRouteButton" Click="StartRoute_Click"
                           Height="40" FontSize="14" FontWeight="Bold"
                           Background="#27AE60" Foreground="White"
                           BorderThickness="0" IsEnabled="False"/>
                </Grid>
            </Border>

            <!-- Right Panel: Active Routes -->
            <Border Grid.Column="2" Background="White" BorderBrush="#BDC3C7"
                   BorderThickness="1" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section Title -->
                    <TextBlock Grid.Row="0" Text="Active Routes" FontSize="16"
                              FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <!-- Active Routes List -->
                    <ListBox Grid.Row="1" x:Name="ActiveRoutesListBox" Margin="0,0,0,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#ECF0F1" BorderThickness="1"
                                       CornerRadius="3" Padding="10" Margin="0,2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="{Binding SourceSession.DisplayName}"
                                                      FontWeight="SemiBold"/>
                                            <TextBlock Foreground="#7F8C8D" FontSize="11">
                                                <Run Text="From: "/>
                                                <Run Text="{Binding SourceDevice.FriendlyName}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="#7F8C8D" FontSize="11">
                                                <Run Text="To: "/>
                                                <Run Text="{Binding TargetDevice.FriendlyName}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="🟢" FontSize="16"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <Slider Width="150" Minimum="0" Maximum="100"
                                                   Value="{Binding Volume, Mode=TwoWay, Converter={StaticResource VolumeConverter}}"
                                                   VerticalAlignment="Center"
                                                   TickFrequency="10" IsSnapToTickEnabled="False"/>
                                            <TextBlock Text="{Binding Volume, StringFormat={}{0:P0}}"
                                                      FontSize="11" VerticalAlignment="Center"
                                                      Margin="5,0,0,0" MinWidth="35"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Stop Route Button -->
                    <Button Grid.Row="2" Content="⏹️ Stop Selected Route"
                           Click="StopRoute_Click" Height="35"
                           Background="#E74C3C" Foreground="White" BorderThickness="0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#34495E" Padding="10" CornerRadius="5" Margin="0,10,0,0">
            <TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="White"/>
        </Border>
    </Grid>
</Window>
