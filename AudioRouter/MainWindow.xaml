<Window x:Class="AudioRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Router - Pro Audio Routing Tool" Height="750" Width="1100"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Closing="Window_Closing">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0A0A0A" BorderBrush="{StaticResource DarkBorder}"
                BorderThickness="1" Padding="20,15" CornerRadius="6" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🎵 Audio Router Pro" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Professional audio routing • Capture from any device • Route to any output"
                              FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border x:Name="AdminBadge" Background="#00C853" CornerRadius="4" Padding="10,5" Margin="0,0,0,6">
                        <TextBlock Text="⚡ ADMIN MODE" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <Button x:Name="RestartAsAdminButton" Content="🔓 Run as Admin"
                           Click="RestartAsAdmin_Click" FontSize="11" Padding="10,6"
                           Background="#FF9800" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Create Routes -->
            <Border Grid.Column="0" Background="{StaticResource DarkPanel}"
                   BorderBrush="{StaticResource DarkBorder}"
                   BorderThickness="1" CornerRadius="6" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Create New Route" FontSize="18"
                                  FontWeight="SemiBold" Foreground="{StaticResource DarkAccent}"/>
                        <TextBlock Text="Select an application and output device to start routing"
                                  FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Audio Sessions -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" FontSize="13">
                            <Run Text="📱 Select Application"/>
                        </TextBlock>
                        <TextBlock Text="Choose the app you want to capture audio from"
                                  FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <ListBox x:Name="AudioSessionsListBox" Height="160"
                                SelectionChanged="AudioSessionsListBox_SelectionChanged"
                                IsSynchronizedWithCurrentItem="False"
                                BorderThickness="1"/>
                        <Button Content="🔄 Refresh Applications" Click="RefreshSessions_Click"
                               HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Output Devices -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" FontSize="13">
                            <Run Text="🔊 Output Device"/>
                        </TextBlock>
                        <TextBlock Text="Where should the audio be routed to?"
                                  FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <ComboBox x:Name="OutputDevicesComboBox"
                                 SelectionChanged="OutputDevicesComboBox_SelectionChanged"
                                 Height="32"/>
                        <Button Content="🔄 Refresh Devices" Click="RefreshDevices_Click"
                               HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Latency Mode -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,15">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" FontSize="13">
                            <Run Text="⚡ Performance Mode"/>
                        </TextBlock>
                        <ComboBox x:Name="LatencyModeComboBox"
                                 SelectionChanged="LatencyModeComboBox_SelectionChanged"
                                 Height="32">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource LatencyModeConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="LatencyInfoText" Text="Ultra Low: Best for movies/gaming"
                                  FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Spacer -->
                    <Border Grid.Row="4"/>

                    <!-- Create Route Button -->
                    <Button Grid.Row="5" Content="▶️ Start Audio Route"
                           x:Name="StartRouteButton" Click="StartRoute_Click"
                           Height="44" FontSize="14" FontWeight="Bold"
                           Background="#00C853" Foreground="White"
                           IsEnabled="False"/>
                </Grid>
            </Border>

            <!-- Right Panel: Active Routes -->
            <Border Grid.Column="2" Background="{StaticResource DarkPanel}"
                   BorderBrush="{StaticResource DarkBorder}"
                   BorderThickness="1" CornerRadius="6" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Active Routes" FontSize="18"
                                  FontWeight="SemiBold" Foreground="{StaticResource DarkAccent}"/>
                        <TextBlock Text="Manage your currently active audio routes"
                                  FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Active Routes List -->
                    <ListBox Grid.Row="1" x:Name="ActiveRoutesListBox" Margin="0,0,0,12"
                            IsSynchronizedWithCurrentItem="False"
                            BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0A0A0A" BorderBrush="{StaticResource DarkBorder}" BorderThickness="1"
                                       CornerRadius="4" Padding="12" Margin="0,3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="{Binding SourceSession.DisplayName}"
                                                      FontWeight="SemiBold" FontSize="14"
                                                      Foreground="White"/>
                                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,2">
                                                <Run Text="📥 From:"/>
                                                <Run Text="{Binding SourceDevice.FriendlyName}" Foreground="{StaticResource TextSecondary}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11">
                                                <Run Text="📤 To:"/>
                                                <Run Text="{Binding TargetDevice.FriendlyName}" Foreground="{StaticResource TextSecondary}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="🟢" FontSize="18"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Slider Width="160" Minimum="0" Maximum="100"
                                                   Value="{Binding Volume, Mode=TwoWay, Converter={StaticResource VolumeConverter}}"
                                                   VerticalAlignment="Center"
                                                   TickFrequency="10" IsSnapToTickEnabled="False"/>
                                            <TextBlock Text="{Binding Volume, StringFormat={}{0:P0}}"
                                                      FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"
                                                      Margin="10,0,0,0" MinWidth="40" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Stop Route Button -->
                    <Button Grid.Row="2" Content="⏹️ Stop Selected Route"
                           Click="StopRoute_Click" Height="40" FontSize="13" FontWeight="SemiBold"
                           Background="#E53935" Foreground="White"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#0A0A0A" BorderBrush="{StaticResource DarkBorder}"
               BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,15,0,0">
            <TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
