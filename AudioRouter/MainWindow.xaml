<Window x:Class="AudioRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Router - Pro Audio Routing Tool" Height="850" Width="1200"
        MinHeight="750" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        WindowStyle="None"
        ResizeMode="CanResize"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                     ResizeBorderThickness="5"
                     GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="#1E1E1E" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="#000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Audio Router - Pro Audio Routing Tool"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          FontSize="12" Foreground="{StaticResource TextPrimary}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="─" Width="46" Height="32"
                           Click="MinimizeButton_Click"
                           Background="Transparent" BorderThickness="0"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="16" Padding="0,-6,0,0"
                           WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1A1A1A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="□" Width="46" Height="32"
                           Click="MaximizeButton_Click"
                           Background="Transparent" BorderThickness="0"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="14"
                           WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1A1A1A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✕" Width="46" Height="32"
                           Click="CloseButton_Click"
                           Background="Transparent" BorderThickness="0"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="14"
                           WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0A0A0A" BorderBrush="{StaticResource DarkBorder}"
                BorderThickness="1" Padding="20,15" CornerRadius="6" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🎵 Audio Router Pro" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Professional audio routing • Capture from any device • Route to any output"
                              FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border x:Name="AdminBadge" Background="#00C853" CornerRadius="4" Padding="10,5" Margin="0,0,0,6">
                        <TextBlock Text="⚡ ADMIN MODE" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <Button x:Name="RestartAsAdminButton" Content="🔓 Run as Admin"
                           Click="RestartAsAdmin_Click" FontSize="11" Padding="10,6"
                           Background="#FF9800" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Create Routes -->
            <Border Grid.Column="0" Background="{StaticResource DarkPanel}"
                   BorderBrush="{StaticResource DarkBorder}"
                   BorderThickness="1" CornerRadius="6" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Create New Route" FontSize="18"
                                  FontWeight="SemiBold" Foreground="{StaticResource DarkAccent}"/>
                        <TextBlock Text="Select an application and output device to start routing"
                                  FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Audio Sessions -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" FontSize="13">
                            <Run Text="📱 Select Application"/>
                        </TextBlock>
                        <TextBlock Text="Choose the app you want to capture audio from"
                                  FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <ListBox x:Name="AudioSessionsListBox" Height="160"
                                SelectionChanged="AudioSessionsListBox_SelectionChanged"
                                IsSynchronizedWithCurrentItem="False"
                                BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- App Icon -->
                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="24" Height="24"
                                              Margin="0,0,8,0" VerticalAlignment="Center"/>

                                        <!-- App Name -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding DeviceName}" FontSize="10"
                                                      Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>

                                        <!-- Playing Indicator -->
                                        <Border Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Background="#00C853" CornerRadius="2" Padding="4,2"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="▶" FontSize="8" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="🔄 Refresh Applications" Click="RefreshSessions_Click"
                               HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Output Devices -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" FontSize="13">
                            <Run Text="🔊 Output Device"/>
                        </TextBlock>
                        <TextBlock Text="Where should the audio be routed to?"
                                  FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <ComboBox x:Name="OutputDevicesComboBox"
                                 SelectionChanged="OutputDevicesComboBox_SelectionChanged"
                                 Height="32"/>
                        <Button Content="🔄 Refresh Devices" Click="RefreshDevices_Click"
                               HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Latency Mode -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,15">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" FontSize="13">
                            <Run Text="⚡ Performance Mode"/>
                        </TextBlock>
                        <ComboBox x:Name="LatencyModeComboBox"
                                 SelectionChanged="LatencyModeComboBox_SelectionChanged"
                                 Height="32">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource LatencyModeConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="LatencyInfoText" Text="Ultra Low: Best for movies/gaming"
                                  FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Spacer -->
                    <Border Grid.Row="4"/>

                    <!-- Create Route Button -->
                    <Button Grid.Row="5" Content="▶️ Start Audio Route"
                           x:Name="StartRouteButton" Click="StartRoute_Click"
                           Height="44" FontSize="14" FontWeight="Bold"
                           Background="#00C853" Foreground="White"
                           IsEnabled="False"/>
                </Grid>
            </Border>

            <!-- Right Panel: Active Routes -->
            <Border Grid.Column="2" Background="{StaticResource DarkPanel}"
                   BorderBrush="{StaticResource DarkBorder}"
                   BorderThickness="1" CornerRadius="6" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Active Routes" FontSize="18"
                                  FontWeight="SemiBold" Foreground="{StaticResource DarkAccent}"/>
                        <TextBlock Text="Manage your currently active audio routes"
                                  FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Active Routes List -->
                    <ListBox Grid.Row="1" x:Name="ActiveRoutesListBox" Margin="0,0,0,12"
                            IsSynchronizedWithCurrentItem="False"
                            BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0A0A0A" BorderBrush="{StaticResource DarkBorder}" BorderThickness="1"
                                       CornerRadius="4" Padding="12" Margin="0,3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Route Info -->
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="{Binding SourceSession.DisplayName}"
                                                      FontWeight="SemiBold" FontSize="14"
                                                      Foreground="White"/>
                                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,2">
                                                <Run Text="📥 From:"/>
                                                <Run Text="{Binding SourceDevice.FriendlyName}" Foreground="{StaticResource TextSecondary}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11">
                                                <Run Text="📤 To:"/>
                                                <Run Text="{Binding TargetDevice.FriendlyName}" Foreground="{StaticResource TextSecondary}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Mute Button -->
                                        <Button Grid.Row="0" Grid.Column="1"
                                               VerticalAlignment="Top"
                                               Width="32" Height="32"
                                               Click="MuteButton_Click"
                                               Tag="{Binding}">
                                            <TextBlock>
                                                <Run Text="{Binding IsMuted, Converter={StaticResource MuteIconConverter}}" FontSize="14"/>
                                            </TextBlock>
                                        </Button>

                                        <!-- Audio Level Meter -->
                                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" Height="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="🎵" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                            <Border Grid.Column="1" Background="#1A1A1A" BorderBrush="{StaticResource DarkBorder}"
                                                   BorderThickness="1" CornerRadius="2" Height="16" VerticalAlignment="Center">
                                                <Grid>
                                                    <!-- Level Fill -->
                                                    <Border Background="{StaticResource DarkAccent}" CornerRadius="1" HorizontalAlignment="Left">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource AudioLevelWidthConverter}">
                                                                <Binding Path="AudioLevel"/>
                                                                <Binding RelativeSource="{RelativeSource AncestorType=Border}" Path="ActualWidth"/>
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Volume Control -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Slider Width="160" Minimum="0" Maximum="100"
                                                   Value="{Binding Volume, Mode=TwoWay, Converter={StaticResource VolumeConverter}}"
                                                   VerticalAlignment="Center"
                                                   TickFrequency="10" IsSnapToTickEnabled="False"/>
                                            <TextBlock Text="{Binding Volume, StringFormat={}{0:P0}}"
                                                      FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"
                                                      Margin="10,0,0,0" MinWidth="40" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Stop Route Button -->
                    <Button Grid.Row="2" Content="⏹️ Stop Selected Route"
                           Click="StopRoute_Click" Height="40" FontSize="13" FontWeight="SemiBold"
                           Background="#E53935" Foreground="White"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#0A0A0A" BorderBrush="{StaticResource DarkBorder}"
               BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,15,0,0">
            <TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
        </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
